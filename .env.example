# Base de datos (docker compose de desarrollo expone Postgres en 5433)
DATABASE_URL=postgres://biblioteca:biblioteca@localhost:5433/biblioteca

# Auth
BETTER_AUTH_SECRET=            # generar con: openssl rand -base64 32
APP_URL=http://localhost:3000

# Admin inicial (seed)
ADMIN_EMAIL=

# Google Drive: por defecto, links públicos (no hace falta nada). Opcional: cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
DRIVE_ROOT_FOLDER_IDS=         # IDs separados por coma
# Solo desarrollo/pruebas sin cuenta de servicio: carpeta local que simula Drive
# (cada subcarpeta es una raíz). Se ignora si hay credenciales de Google.
DRIVE_LOCAL_DIR=

# SMTP de la empresa
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Solo para pruebas locales con `npm start` sin SMTP: muestra los mails en la consola
MAIL_TO_CONSOLE=false

# Worker: hora (Argentina) de la detección de cambios en Drive y tope de páginas de OCR
SYNC_HOUR=3
OCR_MAX_PAGES=80
