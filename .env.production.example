# Producción (docker-compose.prod.yml). Copiar a .env.production y completar.
# Nunca commitear .env.production.

# Dominio público de la app (Caddy saca el certificado HTTPS solo)
DOMAIN=biblioteca.crucianelli.com
APP_URL=https://biblioteca.crucianelli.com

# Base de datos (la URL la arma docker-compose.prod.yml)
POSTGRES_PASSWORD=                # generar con: openssl rand -base64 24

# Auth
BETTER_AUTH_SECRET=               # generar con: openssl rand -base64 32
ADMIN_EMAIL=

# Google Drive: se usan links públicos (docs/08); no hace falta configurar nada.

# SMTP de la empresa
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Biblioteca Técnica Crucianelli <biblioteca@crucianelli.com>"

# Días sin usar la app tras los cuales una cuenta se pausa (0 = nunca)
INACTIVIDAD_DIAS=90

# Worker
SYNC_HOUR=3
OCR_MAX_PAGES=80

# Backups: hora, carpeta en la VPS y copia externa opcional (ej.: rclone)
BACKUP_HOUR=4
BACKUP_DIR=./backups
BACKUP_COPY_CMD=
